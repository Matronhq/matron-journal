# onnxruntime-node (pulled in by the optional @huggingface/transformers)
# downloads CUDA provider libraries (~340 MB) from the network in its
# postinstall on Linux x64. Semantic search runs on the CPU, so skip it.
# npm exports this to install scripts as
# npm_config_onnxruntime_node_install_cuda, which that script reads.
onnxruntime-node-install-cuda=skip
